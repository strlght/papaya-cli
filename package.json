{
  "name": "papaya-cli",
  "version": "0.2.0",
  "description": "Unofficial CLI for Papaya Personal",
  "type": "module",
  "bin": {
    "papaya-cli": "dist/papaya-cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup && chmod +x dist/papaya-cli.js",
    "start": "npm run build && node dist/papaya-cli.js",
    "typecheck": "tsc --noEmit",
    "test": "tsup --config tsup.config.test.ts && node --test \"dist-test/*.test.js\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build"
  },
  "keywords": [
    "papaya",
    "payslip",
    "cli",
    "unofficial"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.2"
  }
}
